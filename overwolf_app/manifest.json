{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "TFT Advisor",
    "version": "1.0.0",
    "minimum_overwolf_version": "0.230.0",
    "author": "amuro",
    "icon": "icon256.png",
    "icon_gray": "icon256.png",
    "launcher_icon": "icon256.png",
    "description": "TFT real-time advisor overlay using Overwolf GEP"
  },
  "permissions": [
    "GameInfo",
    "GameEventsProvider",
    "Extensions",
    "Hotkeys"
  ],
  "data": {
    "game_events": [5426],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [5426] },
        "start_minimized": true
      }
    ],
    "hotkeys": {
      "toggle_overlay": {
        "title": "Toggle Overlay",
        "action-type": "custom",
        "default": "Ctrl+Shift+T"
      }
    },
    "windows": {
      "background": {
        "file": "background.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "size": { "width": 400, "height": 300 },
        "min_size": { "width": 100, "height": 100 }
      },
      "overlay": {
        "file": "windows/overlay.html",
        "transparent": true,
        "resizable": true,
        "show_in_taskbar": false,
        "size": { "width": 640, "height": 850 },
        "min_size": { "width": 600, "height": 40 }
      },
      "augment": {
        "file": "windows/augment.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "size": { "width": 380, "height": 460 }
      },
      "forge": {
        "file": "windows/forge.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "size": { "width": 360, "height": 480 }
      },
      "gods": {
        "file": "windows/gods.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "size": { "width": 400, "height": 520 }
      },
      "godboon": {
        "file": "windows/godboon.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "size": { "width": 380, "height": 460 }
      }
    },
    "start_window": "background"
  }
}
